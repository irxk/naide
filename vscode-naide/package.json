{
  "name": "naide-lang",
  "displayName": "NAIDE Language",
  "description": "Syntax highlighting, diagnostics, and autocomplete for NAIDE (.naide) and NAIDE-X (.nx)",
  "version": "1.1.0",
  "publisher": "irxk",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:naide",
    "onLanguage:naidex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/irxk/naide"
  },
  "contributes": {
    "languages": [
      {
        "id": "naide",
        "aliases": ["NAIDE", "naide"],
        "extensions": [".naide"],
        "configuration": "./language-configuration-naide.json"
      },
      {
        "id": "naidex",
        "aliases": ["NAIDE-X", "naidex", "nx"],
        "extensions": [".nx"],
        "configuration": "./language-configuration-nx.json"
      }
    ],
    "grammars": [
      {
        "language": "naide",
        "scopeName": "source.naide",
        "path": "./syntaxes/naide.tmLanguage.json"
      },
      {
        "language": "naidex",
        "scopeName": "source.naidex",
        "path": "./syntaxes/naidex.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "NAIDE",
      "properties": {
        "naide.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Custom path to naide CLI (leave empty to use PATH)"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
