-- SQLite-backed API (NAIDE-X)
-- npm install better-sqlite3

db.sql "sqlite" "app.db"

env:
  PORT int default(3000)

schema Task:
  id auto
  title str required min(1) max(200)
  done bool default(false)

$app:PORT
  cors "*"
  crud "/api/tasks" Task

  U"/api/tasks/:id/toggle"(req,res)
    task=TaskStore.getById(req.params.id)
    ?not task
      >.s 404 {error:"Not found"}
    updated=TaskStore.update(req.params.id,{done:!task.done})
    >updated
