-- ============================================
-- NAIDE-X Language Specification
-- ~80% fewer tokens than JavaScript
-- AI-only readability. Maximum generation speed.
-- ============================================
-- Rule: first char of line = intent
--   > return    ? if       | elif     : else
--   @ loop      * while    ! try      !! catch   !!! ensure
--   $ server    ^ model    < import   % match   X patch
--   f func      ~f async   + export
--   s:i:n:b:l:m:a: typed vars
--   ~ await     ~~ await.all
-- ============================================

-- Types: s=str i=int n=num b=bool l=list m=map a=any
s:name="hello"
i:count=42
n:price=9.99
b:active=true
l:items=[1,2,3]
m:cfg={host:"localhost",port:3000}
a:data=null

-- Mutable: ~ prefix
~i:counter=0
~s:label="init"

-- String interpolation: "{expr}" (double quotes)
s:greet="Hello {name}, count is {count}"

-- Functions: f name(TYPE:param,...)RETTYPE
f add(i:a,i:b)i
  >a+b

f sayHi(s:who)
  log"Hi {who}"

f greet2(s:name,s:prefix="Hello")
  log"{prefix}, {name}!"

-- Async: ~f
~f fetchUser(s:id)m
  a:res=~fetch("/api/users/{id}")
  a:data=~res.json()
  >data

-- Return: >
-- Return with status: >.s CODE BODY

-- If/elif/else: ? | :
?count>10
  log"many"
|count>5
  log"some"
:
  log"few"

-- Inline ternary (same as NAIDE v1)
-- s:size=if count>10 then "big" else "small"

-- Each: @var<collection
@item<items
  log item

-- Each with key: @key,val<collection
@k,v<cfg
  log"{k}: {v}"

-- For range: @var<start..end
@i<0..10
  log i

-- While: *condition
*active
  log"running"
  active=false

-- Match: %value
s:status="ok"
%status
  "ok": log "success"
  "error": log "failed"
  _: log "unknown"

-- Try/catch/ensure: ! / !!var / !!!
~f safe(s:url)m
  !
    a:data=~fetch(url)
    >{ok:true,data:data}
  !!e
    log.e"fail: {e.message}"
    >{ok:false,error:e.message}
  !!!
    log"request done"

-- typeof / instanceof
?typeof x=="string"
  log"is string"
?err instanceof TypeError
  log"type error"

-- Pipe: |> (same)
l:result=[1,2,3,4,5]
  |>filter((x)=>x>2)
  |>map((x)=>x*10)

-- Model: ^Name
^User
  s:name
  s:email
  i:age=0
  f greet()s
    >"Hi, I'm {self.name}"
  ~f save()
    log"Saving {self.name}..."

-- Inheritance: ^Child<Parent
^Admin<User
  s:role="admin"
  f perms()l
    >["read","write","delete"]

-- DB persistence: db "path/"
db "data/"

-- SQL database: db.sql "driver" "connection"
-- db.sql "sqlite" "app.db"
-- db.sql "postgres" "postgresql://localhost/mydb"

-- Environment variables
env:
  PORT int default(3000)
  JWT_SECRET str required

-- Schema: types + modifiers
schema User:
  id auto
  name str required min(2) max(50)
  email str required email unique
  role enum("admin","user") default("user")
  joined timestamp auto

-- Server with high-level features
$app:PORT
  cors "*"
  auth JWT_SECRET:
    protect "/api/*"
    public "/api/auth/*"
  limit "/api/*" 100 "1m"
  static "/public"
  crud "/api/users" User
  cookie
  session JWT_SECRET
  cache "/api/*" "5m"
  view "./views"
  sse "/events"
  upload "/api/upload" "avatar" (req,res):
    >{file:req.file.filename}
  -- Route middleware: [mid1, mid2]
  G"/admin"[authCheck](req,res)
    >{admin:true}
  P"/api/secure"[auth,logger](req,res)
    >req.body
  group "/api/v1":
    G"/status"
      >{version:"1.0"}
  G"/"
    >.h "<h1>Welcome</h1>"
  P"/api/auth/register"(req,res)
    s:hashed=hash(req.body.password)
    user=UserStore.create({...req.body,password:hashed})
    token=auth.sign({id:user.id})
    >{token,user}
  P"/api/auth/login"(req,res)
    user=UserStore.where({email:req.body.email})[0]
    ?not user
      >.s 401 {error:"Invalid credentials"}
    ?not verify(req.body.password,user.password)
      >.s 401 {error:"Invalid credentials"}
    token=sign({id:user.id})
    >{token}
  ws "/chat":
    on "connect":
      send({type:"welcome"})
    on "message" (data):
      broadcast(data)

-- Error handler
  error (err, req, res):
    log.e err.message
    >.s 500 {error:"Internal error"}

-- HTTP client (auto-imported)
-- api.get(url) api.post(url,body) api.put(url,body) api.del(url) api.raw(url,opts)

-- Return helpers
-- >expr         → JSON
-- >.s CODE expr → status code
-- >.r "/path"   → redirect
-- >.h "<html>"  → HTML
-- >.t "text"    → plain text
-- >.f "/file"   → send file
-- >.d "/file"   → download
-- >.v "tmpl" {} → render template

-- Built-in functions (auto-imported)
-- uuid()                → UUID
-- hash("password")      → scrypt hash
-- verify("pw",hashed)   → verify
-- sign({id:1})          → JWT (uses auth secret)
-- sign({id:1},"secret") → JWT (explicit)

-- Validate: auto-validate POST/PUT/PATCH bodies
--   validate "/api/users" User

-- Test (node:test)
test "math":
  assert 1+1==2
  assert 2*3==6

-- Queue (async job queue)
queue jobs:
  job "notify" (data):
    log data.msg

-- OpenAPI: auto-generate spec from schemas
--   openapi "/docs"

-- AI / LLM integration (auto-imported, zero-dep)
-- s:answer=~ai.ask("Explain NAIDE")
-- m:result=~ai.json("List 3 colors",{colors:["string"]})
-- s:reply=~ai.chat(msgs)
-- s:a=~ai.ask("hi",{model:"gpt-4o",maxTokens:100})
-- Streaming: ~f main(): @chunk<~ai.stream("poem") ...
-- Embed: l:vec=~ai.embed("hello")
-- Similarity: n:score=ai.similarity(a,b)

-- Prompt template
-- prompt summarize {lang:"en"}:
--   "Summarize in {lang}: {text}"

-- Inter-file import (.naide/.nx → .mjs auto-rewrite)
-- <{handler}"./routes.naide"

-- Scheduled tasks
every "5m":
  log"cleanup"

-- Event watch
watch User.create (event):
  log"new: {event.data.name}"

-- Import: <module or <{names}"module"
-- <express
-- <{readFile,writeFile}"fs/promises"

-- Export: + prefix
+f helper()s
  >"exported"
+s:VER="1.0.0"

-- Log: log, log.e, log.w, log.i, log.d
log"info"
log.e"error"
log.w"warning"
log.i"info level"
log.d"debug level"

-- Null safe: ?. and ?? (same)
a:val=data?.nested?.value??"default"

-- Await all: ~~[expr1,expr2]

-- Spread: ...
l:combined=[...items,4,5,6]
m:merged={...cfg,debug:true}
