# ============================================
# NAIDE Language Specification
# Node AI Development Environment
# ============================================
# 人間とAIが同じ構文を読み書きできる、実用的なプログラミング言語
#
# 設計原則:
#   1. 構文はひとつ。人間・AI・ツールで異なる方言を持たない
#   2. 短さは記号暗記ではなく、型推論と明快な標準機能で実現する
#   3. 制御フロー・非同期・失敗の扱いはコードから読み取れる
#   4. よく使う仕事を支援しつつ、暗黙の副作用を増やさない
#   5. 型検査・診断・テストで、実行前に誤りを見つけやすくする
#   6. コンパイラの出力と実行時の挙動を追跡できるようにする
#   7. 新機能は構文の一貫性、保守性、ターゲット間の意味保存を満たしてから追加
#   8. 直接実行エンジンは段階的に導入し、未対応機能を明示する
# ============================================

# ---- 直接実行エンジン ----
# `naide file.naide` interprets the parsed NAIDE AST without generating JavaScript.
# The interpreter supports core expressions, functions, conditions, loops, match,
# basic error handling, generators, models, fn.async, await, and await.all.
# Relative .naide imports and installed NAIDE packages with naide.pkg.json
# manifests and in-package .naide main entries are supported and cached.
# Package subpaths must be explicitly mapped to in-package .naide files by
# exact exports keys. JavaScript npm dependencies require declaration in the
# project manifest; Node.js built-ins require an explicit --node-module grant.
# The async native runtime exposes io.readText, io.writeText, io.appendText,
# io.exists, and io.listDir. File paths are relative to the entry file's
# directory and are rejected if they escape that project root.
# It also exposes http.request/get/post using the host Fetch implementation,
# restricted to absolute HTTP(S) URLs. Embedders may inject an HTTP capability.
# The native HTTP server supports JSON routes, schemas, file-backed CRUD,
# bearer authentication (secrets must be at least 32 UTF-8 bytes), cookie
# parsing, redirects, CORS, rate limits, and project-confined static files.
# It binds to 127.0.0.1 by default. Unsupported advanced declarations fail
# explicitly; use the compiler compatibility path for those features.
# task.spawn/all/race/map/sleep provide cooperative asynchronous task coordination;
# task.map takes (items, concurrencyLimit, asyncCallback) and keeps result order.
# task.controller creates a cancellation signal; task.withTimeout appends one to
# a callback and aborts it when the deadline expires. Cancellation is cooperative.
# task.channel(capacity) creates a FIFO message channel; capacity 0 is rendezvous.
# receive returns {value, done}; close drains buffered messages then ends receivers.
# send(value, signal) and receive(signal) can cancel a queued operation and remove it.
# Enum declarations produce frozen objects whose members have zero-based values;
# pub enum values may be imported from native NAIDE modules.
# Models support new, defaulted fields, init(params) constructors, methods using
# self, async methods, and single inheritance. Overrides can call parent methods
# with super.method(). Initialized static fields, static fn, and static fn.async
# are supported and inherited. Static self follows the called model; static
# overrides can call parent methods using super.method(), including async ones.
# pub model declarations may be imported.
# they do not schedule CPU work across parallel threads.
# This is not yet a CPU-parallel or performance VM; bytecode/JIT optimization is future work.
# Runtime failures report NAIDE line locations and function/file stack frames when known.
# runtime.args/cwd/platform/arch expose limited host context. runtime.env contains
# only explicitly injected variables; the CLI opts in with --env NAME.
# runtime.exitCode sets the CLI exit status. Arbitrary process and shell access
# are intentionally not part of the native runtime.
# The REPL also interprets AST directly; .compile is explicit inspection mode.
# Compiler-only targets and debugging workflows remain available by opt-in.


# ---- 変数宣言 ----
# 型名 変数名 = 値 (不変 const)
str name = "hello"
int count = 42
num price = 9.99
bool active = true
list items = [1, 2, 3]
map config = {host: "localhost", port: 3000}
any data = null

# 可変変数 (let)
mut int counter = 0
mut str label = "initial"

# auto 型推論 (コンパイラが型を推論)
auto x = 42                  # const x = 42
auto msg = "hello"           # const msg = "hello"
auto items = [1, 2, 3]       # const items = [1, 2, 3]
mut auto counter2 = 0        # let counter2 = 0


# ---- 分割代入 (Destructuring) ----
# オブジェクト分割代入
auto {name2, age} = user
auto {name3, age2 = 0} = user         # デフォルト値
auto {name4, ...rest} = user           # レスト
mut {score, level} = gameState         # 可変

# 配列分割代入
auto [first, second] = items
auto [head, ...tail] = items           # レスト
auto [x2, y = 0] = coords             # デフォルト値
mut [a3, b3] = pair                    # 可変


# ---- 文字列補間 ----
# ダブルクォートで {式} が自動展開
str greeting = "Hello {name}, count is {count}"


# ---- 関数 ----
# fn 名前(型 引数) -> 戻り型:
fn add(int a, int b) -> int:
  ret a + b

# 戻り値なし
fn sayHi(str who):
  log "Hi {who}"

# デフォルト引数
fn greet(str name, str prefix = "Hello"):
  log "{prefix}, {name}!"

# 可変長引数
fn sum(...int nums) -> int:
  mut int total = 0
  each n in nums:
    total += n
  ret total


# ---- 非同期関数 ----
fn.async fetchUser(str id) -> map:
  any res = await fetch("/api/users/{id}")
  any data = await res.json()
  ret data


# ---- 条件分岐 ----
if count > 10:
  log "many"
elif count > 5:
  log "some"
else:
  log "few"

# インライン三項
str size = if count > 10 then "big" else "small"


# ---- ループ ----
# each: コレクション反復
each item in items:
  log item

# each with key (Object.entries)
each key, val in config:
  log "{key}: {val}"

# for: 範囲ループ
for i in 0..10:
  log i

# while
while active:
  log "running"
  active = false


# ---- パターンマッチ ----
str status = "ok"
match status:
  "ok": log "success"
  "error": log "failed"
  _: log "unknown"


# ---- エラーハンドリング ----
fn.async safeFetch(str url) -> map:
  try:
    any data = await fetch(url)
    ret {ok: true, data: data}
  fail e:
    log.error e.message
    ret {ok: false, error: e.message}
  ensure:
    log "request completed"

# try/ensure (finally) — fail ブロックなしでも使える
fn.async withCleanup():
  any conn = null
  try:
    conn = await openConnection()
    ret await conn.query("SELECT 1")
  ensure:
    if conn:
      conn.close()


# ---- 型チェック ----
# typeof: 型を文字列で返す
if typeof data == "string":
  log "data is a string"

# instanceof: インスタンス判定
if err instanceof TypeError:
  log "type error occurred"


# ---- map/filter/reduce ビルトイン ----
# コレクション操作の組み込み関数
fn.gen count(int start, int end):
  for value in start..end:
    yield value

list counted = Array.from(count(1, 4))

fn.async.gen loadRecords(ids):
  for await id of ids:
    yield await loadRecord(id)

list records = await mapAsync(loadRecords(ids), 4, (record) => record)

fn.async sumStream(any stream):
  mut int total = 0
  for await value of stream:
    total += value
  ret total

list doubled = map(items, (x) => x * 2)
list big = filter(items, (x) => x > 5)
int total2 = reduce(items, (a, b) => a + b, 0)
any found = find(items, (x) => x > 3)
bool allBig = every(items, (x) => x > 0)
bool hasBig = some(items, (x) => x > 10)
list flattened = flatMap(items, (x) => x.children)
list distinct = unique(items)
list indexed = enumerate(items)
list pairs = zip(items, labels)
list batches = chunk(items, 25)
list [validItems, invalidItems] = partition(items, isValid)
any groupedItems = groupBy(items, (item) => item.category)
int matchingCount = count(items, isValid)
any total3 = sum(items)
any firstItem = first(items, null)
list sample = take(items, 10)
list positivePrefix = takeWhile(items, (x) => x > 0)
list afterHeader = drop(items, 1)

# Async callbacks; helpers consume async generators and bounded concurrency applies to callbacks.
list loaded = await task.map(ids, 4, loadItem)
list valid = await filterAsync(items, 4, isValidAsync)
any total4 = await reduceAsync(items, addAsync, 0)
await forEachAsync(items, 4, saveAsync)
any firstLoaded = await firstAsync(loadRecords(ids))
any matchingRecord = await findAsync(loadRecords(ids), (x) => x.id == wanted)
bool hasMissing = await someAsync(loadRecords(ids), (x) => x == null)
bool allValid = await everyAsync(loadRecords(ids), isValidAsync)
list firstPage = await takeAsync(loadRecords(ids), 20)
list matchingPrefix = await takeWhileAsync(loadRecords(ids), isValidAsync)
list asyncPairs = await zipAsync(loadRecords(ids), labels)
list asyncBatches = await chunkAsync(loadRecords(ids), 20)
list [accepted, rejected] = await partitionAsync(loadRecords(ids), isValidAsync)
any asyncGrouped = await groupByAsync(loadRecords(ids), (record) => record.category)
int asyncCount = await countAsync(loadRecords(ids), isValidAsync)
list asyncDistinct = await uniqueAsync(loadRecords(ids))


# ---- パイプ演算子 ----
# データ変換チェーンが読みやすい
list result = [1, 2, 3, 4, 5]
  |> filter((x) => x > 2)
  |> map((x) => x * 10)

# パイプ + map/filter/reduce の組み合わせ
list names = users
  |> filter((u) => u.active)
  |> map((u) => u.name)
  |> sort()


# ---- クラス (model) ----
model User:
  str name
  str email
  int age = 0

  fn greet() -> str:
    ret "Hi, I'm {self.name}"

  fn.async save():
    log "Saving {self.name}..."

# 継承
model Admin extends User:
  str role = "admin"

  fn permissions() -> list:
    ret ["read", "write", "delete"]


# ---- スキーマ継承 (schema extends) ----
# schema も extends で継承可能
schema Animal:
  id       auto
  name     str required
  species  str required

schema Dog extends Animal:
  breed    str optional
  trained  bool default(false)

  init(str name, str breed):
    self.name = name
    self.breed = breed

  fn bark() -> str:
    ret "Woof! I'm {self.name}"


# ---- データベース永続化 ----
# db ディレクトリパス → スキーマストアがJSONファイルに自動保存
db "data/"

# SQLデータベース — スキーマストアがSQLテーブルに自動保存
# db.sql "sqlite" "app.db"          # SQLite (better-sqlite3)
# db.sql "postgres" "postgres://localhost/mydb"  # PostgreSQL


# ---- 環境変数 ----
env:
  PORT       int default(3000)
  JWT_SECRET str required
  DB_URL     str default("sqlite:data.db")


# ---- スキーマ定義 ----
# 型: str, int, num, bool, auto(UUID), timestamp, enum(...)
# 修飾: required, optional, min(n), max(n), email, url, unique, auto, default(val)
schema User:
  id       auto
  name     str required min(2) max(50)
  email    str required email unique
  age      int optional min(0) max(150)
  role     enum("admin", "user") default("user")
  joined   timestamp auto


# ---- サーバー定義 ----
server app port PORT:
  # CORS
  cors "*"

  # JWT認証
  auth JWT_SECRET:
    protect "/api/*"
    public "/api/auth/*"

  # レート制限
  limit "/api/*" 100 "1m"

  # 静的ファイル配信
  static "/public"

  # CRUD自動生成 (ページネーション・検索・ソート付き)
  crud "/api/users" User

  # クッキーパーサー
  cookie

  # セッション管理 (cookie-based, ゼロ依存)
  session JWT_SECRET

  # レスポンスキャッシュ
  cache "/api/*" "5m"

  # テンプレートエンジン
  view "./views"

  # Server-Sent Events
  sse "/events"

  # ファイルアップロード (ゼロ依存)
  upload "/api/upload" "avatar" (req, res):
    ret {file: req.file.filename, size: req.file.size}

  # 名前付きミドルウェア適用
  # mid myMiddleware
  # mid myMiddleware "/api"

  # ルートミドルウェア (ルートごとにミドルウェア適用)
  get "/admin" [authCheck] (req, res):
    ret {admin: true}

  post "/api/secure" [auth, logger] (req, res):
    ret req.body

  # ルートグループ
  group "/api/v1":
    get "/status":
      ret {version: "1.0"}

  # ルート
  get "/":
    ret.html "<h1>Welcome</h1>"

  post "/api/auth/register" (req, res):
    str hashed = hash(req.body.password)
    user = UserStore.create({...req.body, password: hashed})
    token = auth.sign({id: user.id})
    ret {token, user}

  post "/api/auth/login" (req, res):
    user = UserStore.where({email: req.body.email})[0]
    if not user:
      ret.status 401 {error: "Invalid credentials"}
    if not verify(req.body.password, user.password):
      ret.status 401 {error: "Invalid credentials"}
    token = sign({id: user.id})
    ret {token}

  # WebSocket
  ws "/chat":
    on "connect":
      send({type: "welcome"})
    on "message" (data):
      broadcast(data)
    on "close":
      log "client left"

  # エラーハンドラー
  error (err, req, res):
    log.error err.message
    ret.status 500 {error: "Internal error"}


