# ---- null安全 ----
# オプショナルチェーニング (?.)
any val = data?.nested?.value ?? "default"
str userName = user?.name
any first = items?.[0]
any maybeResult = obj?.method?.()
any optionalCall = callback?.("argument")
any optionalIndex = dictionary?.["key"]

# Null合体演算子 (??)
str displayName = user?.name ?? "Anonymous"
int port = config?.port ?? 3000

# ---- 動的インポートと複合代入 ----
any plugin = await import("./plugins/report.naide")
mut num total = 10
total *= 2
total /= 4
total %= 3
total ??= 1
mut bool enabled = true
enabled &&= hasPermission
mut str label = ""
label ||= "default"
bool sameType = value === other
bool differentType = value !== other

# ---- JavaScript互換の式・リテラル（Node.js/Bun/ブラウザー） ----
# バッククォート文字列の ${...} 内は JavaScript 式としてそのまま出力され、NAIDE 式としては解析されない。
# これらの機能は JavaScript 生成ターゲット専用。ほかのターゲットではコンパイル時にエラーになる。
bigint precise = 9_007_199_254_740_993n
int hex = 0x2a
int binary = 0b1010
int octal = 0o17
num exponent = 1.25e2
str template = `value=${hex}`
bool matches = /value=\d+/i.test(template)
int power = 2 ** 3 ** 2
int bits = (5 << 1) | 1
int selected = power > 0 ? bits : 0
mut int counter = 0
counter++
++counter

# ---- iterator / post-test loops ----
for item of [1, 2, 3]:
  log item

for key in {first: 1, second: 2}:
  log key

do:
  counter--
while counter > 0

# ---- generator functions ----
fn.gen values():
  yield 1
  yield* [2, 3]

fn.async.gen asyncValues():
  yield 4

# JavaScript互換機能はNode.js/Bun/ブラウザー向け生成対象。任意のJavaScript
# ファイルを直接解析する機能ではなく、その他の生成ターゲットは未対応機能を診断する。

