# ============================================
# NAIDE Language Specification
# Node AI Development Environment
# ============================================
# AIが最速でコード生成できるように設計された言語
#
# 設計原則:
#   1. 1つの書き方しかない (曖昧さゼロ)
#   2. キーワード駆動 (行頭で意図が確定)
#   3. 最小トークン数 (生成量削減 = 高速)
#   4. よく使うパターンが組み込み
#   5. インデントベース (波括弧不要)
# ============================================


# ---- 変数宣言 ----
# 型名 変数名 = 値 (不変 const)
str name = "hello"
int count = 42
num price = 9.99
bool active = true
list items = [1, 2, 3]
map config = {host: "localhost", port: 3000}
any data = null

# 可変変数 (let)
mut int counter = 0
mut str label = "initial"


# ---- 文字列補間 ----
# ダブルクォートで {式} が自動展開
str greeting = "Hello {name}, count is {count}"


# ---- 関数 ----
# fn 名前(型 引数) -> 戻り型:
fn add(int a, int b) -> int:
  ret a + b

# 戻り値なし
fn sayHi(str who):
  log "Hi {who}"

# デフォルト引数
fn greet(str name, str prefix = "Hello"):
  log "{prefix}, {name}!"

# 可変長引数
fn sum(...int nums) -> int:
  mut int total = 0
  each n in nums:
    total += n
  ret total


# ---- 非同期関数 ----
fn.async fetchUser(str id) -> map:
  any res = await fetch("/api/users/{id}")
  any data = await res.json()
  ret data


# ---- 条件分岐 ----
if count > 10:
  log "many"
elif count > 5:
  log "some"
else:
  log "few"

# インライン三項
str size = if count > 10 then "big" else "small"


# ---- ループ ----
# each: コレクション反復
each item in items:
  log item

# each with key (Object.entries)
each key, val in config:
  log "{key}: {val}"

# for: 範囲ループ
for i in 0..10:
  log i

# while
while active:
  log "running"
  active = false


# ---- パターンマッチ ----
str status = "ok"
match status:
  "ok": log "success"
  "error": log "failed"
  _: log "unknown"


# ---- エラーハンドリング ----
fn.async safeFetch(str url) -> map:
  try:
    any data = await fetch(url)
    ret {ok: true, data: data}
  fail e:
    log.error e.message
    ret {ok: false, error: e.message}


# ---- パイプ演算子 ----
# データ変換チェーンが読みやすい
list result = [1, 2, 3, 4, 5]
  |> filter((x) => x > 2)
  |> map((x) => x * 10)


# ---- クラス (model) ----
model User:
  str name
  str email
  int age = 0

  fn greet() -> str:
    ret "Hi, I'm {self.name}"

  fn.async save():
    log "Saving {self.name}..."

# 継承
model Admin extends User:
  str role = "admin"

  fn permissions() -> list:
    ret ["read", "write", "delete"]


# ---- データベース永続化 ----
# db ディレクトリパス → スキーマストアがJSONファイルに自動保存
db "data/"


# ---- 環境変数 ----
env:
  PORT       int default(3000)
  JWT_SECRET str required
  DB_URL     str default("sqlite:data.db")


# ---- スキーマ定義 ----
# 型: str, int, num, bool, auto(UUID), timestamp, enum(...)
# 修飾: required, optional, min(n), max(n), email, url, unique, auto, default(val)
schema User:
  id       auto
  name     str required min(2) max(50)
  email    str required email unique
  age      int optional min(0) max(150)
  role     enum("admin", "user") default("user")
  joined   timestamp auto


# ---- サーバー定義 ----
server app port PORT:
  # CORS
  cors "*"

  # JWT認証
  auth JWT_SECRET:
    protect "/api/*"
    public "/api/auth/*"

  # レート制限
  limit "/api/*" 100 "1m"

  # 静的ファイル配信
  static "/public"

  # CRUD自動生成 (ページネーション・検索・ソート付き)
  crud "/api/users" User

  # クッキーパーサー
  cookie

  # ルートグループ
  group "/api/v1":
    get "/status":
      ret {version: "1.0"}

  # ルート
  get "/":
    ret.html "<h1>Welcome</h1>"

  post "/api/auth/register" (req, res):
    str hashed = hash(req.body.password)
    user = UserStore.create({...req.body, password: hashed})
    token = auth.sign({id: user.id})
    ret {token, user}

  post "/api/auth/login" (req, res):
    user = UserStore.where({email: req.body.email})[0]
    if not user:
      ret.status 401 {error: "Invalid credentials"}
    if not verify(req.body.password, user.password):
      ret.status 401 {error: "Invalid credentials"}
    token = sign({id: user.id})
    ret {token}

  # WebSocket
  ws "/chat":
    on "connect":
      send({type: "welcome"})
    on "message" (data):
      broadcast(data)
    on "close":
      log "client left"

  # エラーハンドラー
  error (err, req, res):
    log.error err.message
    ret.status 500 {error: "Internal error"}


# ---- HTTPクライアント (自動インポート) ----
# any data = await api.get("https://api.example.com/users")
# any result = await api.post("https://api.example.com/users", {name: "test"})
# any result = await api.put(url, body)
# any result = await api.del(url)
# any raw = await api.raw(url, opts)


# ---- レスポンスヘルパー ----
# ret {data}                → JSON応答
# ret.status 404 {error}    → ステータスコード付き
# ret.redirect "/login"     → リダイレクト
# ret.html "<h1>Hi</h1>"   → HTML応答
# ret.text "pong"           → テキスト応答
# ret.file "/path/to/file" → ファイル送信


# ---- 組み込み関数 (自動インポート) ----
# str id = uuid()                    → UUID生成
# str h = hash("password")           → パスワードハッシュ (scrypt)
# bool ok = verify("password", h)    → パスワード検証
# str token = sign({id: 1})          → JWT署名 (auth秘密鍵を自動使用)
# str token = sign({id: 1}, "secret") → JWT署名 (明示的秘密鍵)


# ---- スケジュールタスク ----
every "5m":
  log "cleanup running"


# ---- イベント監視 ----
watch User.create (event):
  log "new user: {event.data.name}"


# ---- インポート ----
# use モジュール名
# use {名前1, 名前2} from "モジュール"
# use モジュール from "パッケージ"
# use モジュール as 別名


# ---- ログ ----
log "info message"
log.error "error message"
log.warn "warning"


# ---- 公開 (export) ----
pub fn helper() -> str:
  ret "exported"

pub str VERSION = "1.0.0"


# ---- null安全 ----
any val = data?.nested?.value ?? "default"


# ---- await.all (Promise.all) ----
# list results = await.all [expr1, expr2, expr3]


# ---- スプレッド ----
list combined = [...items, 4, 5, 6]
map merged = {...config, debug: true}
