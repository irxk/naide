# server app port 3000:
#   validate "/api/users" User


# ---- テスト (node:test ベース) ----
test "math operations":
  assert 1 + 1 == 2
  assert 10 - 3 == 7

test "string operations":
  str name = "NAIDE"
  assert name == "NAIDE"


# ---- ジョブキュー (インメモリ非同期) ----
queue jobs:
  job "sendEmail" (data):
    log "sending to {data.to}"
  job "resize" (data):
    log "resizing {data.path}"


# ---- OpenAPI 自動生成 ----
# server app port 3000:
#   openapi "/docs"    # スキーマからOpenAPI仕様を自動生成して配信


# ---- レスポンスヘルパー ----
# ret {data}                    → JSON応答
# ret.status 404 {error}        → ステータスコード付き
# ret.redirect "/login"         → リダイレクト
# ret.redirect 301 "/new"       → ステータス付きリダイレクト
# ret.html "<h1>Hi</h1>"       → HTML応答
# ret.text "pong"               → テキスト応答
# ret.file "/path/to/file"     → ファイル送信
# ret.download "/file.zip"      → ファイルダウンロード
# ret.download "/file" "name"   → 名前付きダウンロード
# ret.render "template" {data}  → テンプレート描画


# ---- 組み込み関数 (自動インポート) ----
# str id = uuid()                    → UUID生成
# str h = hash("password")           → パスワードハッシュ (scrypt)
# bool ok = verify("password", h)    → パスワード検証
# str token = sign({id: 1})          → JWT署名 (auth秘密鍵を自動使用)
# str token = sign({id: 1}, "secret") → JWT署名 (明示的秘密鍵)


