# ---- Discord Bot ----
# bot構文でDiscord Botを簡単に作成
bot myBot token "YOUR_TOKEN":
  on "ready":
    log "Bot is online!"
  on "message" (msg):
    if msg.content == "!ping":
      msg.reply("Pong!")
  slash "hello" "挨拶します":
    interaction.reply("こんにちは！")
  slash "ask" "AIに質問":
    str answer = await ai.ask(interaction.options.getString("question"))
    interaction.reply(answer)

# Node.js → discord.js, Python → discord.py, Bun → discord.js


# ---- スケジュールタスク ----
every "5m":
  log "cleanup running"


# ---- イベント監視 ----
watch User.create (event):
  log "new user: {event.data.name}"


# ---- インポート ----
# use モジュール名
# use {名前1, 名前2} from "モジュール"
# use モジュール from "パッケージ"
# use モジュール as 別名
# use {handler} from "./routes.naide"     # NAIDEファイル間インポート (.mjs に自動変換)


# ---- ログ ----
log "info message"
log.error "error message"
log.warn "warning"
log.info "info level"
log.debug "debug level"


# ---- 公開 (export) ----
pub fn helper() -> str:
  ret "exported"

pub str VERSION = "1.0.0"


# ---- null安全 ----
any val = data?.nested?.value ?? "default"


# ---- await.all (Promise.all) ----
# list results = await.all [expr1, expr2, expr3]


# ---- スプレッド ----
list combined = [...items, 4, 5, 6]
map merged = {...config, debug: true}


# ---- ページ生成 (HTML) ----
page "index.html":
  title "My App"
  style "styles.css"
  div "container":
    h1 "Hello World"
    p "Welcome to NAIDE"
    a "https://example.com" "Click here"
  script "app.js"


# ---- CLI アプリ ----
cli myTool "A useful tool":
  arg "name" str "Your name"
  arg "count" int "Number of times"
  flag "v" "verbose" "Verbose output"
  run (args):
    log "Hello {args.name}"


# ---- メール送信 ----
mail "smtp.gmail.com" 587:
  user env.MAIL_USER
  pass env.MAIL_PASS
# usage: mail.send("to@email.com", "Subject", "Body")


# ---- Cron / スケジュール ----
every "5s":
  log "every 5 seconds"

every "*/5 * * * *":
  log "cron: every 5 minutes"


# ---- GraphQL (サーバー内) ----
server app port 3000:
  graphql "/graphql"
# schema定義からGraphQLスキーマを自動生成


# ---- マルチプラットフォーム Bot ----
bot myBot token "TOKEN":
  on "message" (msg):
    msg.reply("Hello!")

bot slackBot type "slack" token "xoxb-xxx":
  on "message" (msg):
    msg.reply("Hi from Slack!")

bot tgBot type "telegram" token "123:ABC":
  on "message" (msg):
    msg.reply("Hi from Telegram!")

bot lineBot type "line" token "LINE_TOKEN":
  on "message" (event):
    log event


# ---- デスクトップアプリ ----
desktop myApp:
  title "My Desktop App"
  size 1024 768
  load "index.html"


# ---- モバイル / スクリーン ----
screen Home:
  text "Hello World"
  button "Click Me"
  input "Enter your name"
  image "logo.png"


# ---- OAuth (ソーシャルログイン) ----
oauth "google" env.CLIENT_ID env.CLIENT_SECRET:
  callback "/auth/callback"
  scope "email profile"

oauth "github" env.GH_ID env.GH_SECRET:
  callback "/auth/github/callback"
  scope "user:email"


# ---- 決済 (Stripe) ----
pay "stripe" env.STRIPE_KEY:
  webhook "/webhook"
  success "/thanks"
  cancel "/cancel"
# usage: pay.checkout([{name: "Item", price: 1000, qty: 1}])


# ---- ファイルストレージ (S3/GCS) ----
storage "s3" env.BUCKET env.AWS_KEY env.AWS_SECRET:
  region "ap-northeast-1"
# usage: storage.upload("key", data)
# usage: storage.download("key")
# usage: storage.remove("key")


# ---- PDF生成 ----
pdf "report.pdf":
  title "Monthly Report"
  h1 "Summary"
  text "This is the report content."
  line
  image "chart.png"


# ---- i18n (多言語) ----
i18n "locales/":
  default "en"
  lang "en" "en.json"
  lang "ja" "ja.json"
# usage: i18n.t("greeting.hello")
# usage: i18n.setLang("ja")


# ---- Push通知 ----
push env.VAPID_PUBLIC env.VAPID_PRIVATE:
  endpoint "/subscribe"
# usage: push.send(subscription, "Title", "Body")


# ---- 全文検索 ----
search "meilisearch" "http://localhost:7700" env.MEILI_KEY:
  index "products"
# usage: search.query("keyword")
# usage: search.add([{id: 1, name: "Item"}])


# ---- 画像処理 ----
image "photo.jpg" -> "output.jpg":
  resize 800 600
  grayscale
  watermark "logo.png"


# ---- CSV/Excelエクスポート ----
csv "users" format "csv":
  columns "name" "email" "age"
  from data
# Excel形式
csv "report" format "xlsx":
  columns "id" "value" "date"
  from items
  output "monthly_report.xlsx"

# ---- ロギング ----
logging "app":
  level "info"
  file "app.log"
  format "json"
  rotate "14d"
# usage: logger.info("message"), logger.error("fail")

# ---- DBマイグレーション ----
migrate "create_users":
  up:
    log "Creating users table"
  down:
    log "Dropping users table"

# ---- gRPC ----
grpc "users" port 50051:
  rpc getUser(id) -> user
  rpc createUser(data) -> user
  rpc deleteUser(id) -> result

# ---- WebRTC ----
webrtc "video-chat":
  stun "stun:stun.l.google.com:19302"
  on offer(data):
    log "Received offer"
  on answer(data):
    log "Received answer"
  on candidate(data):
    log "ICE candidate"

# ---- ブロックチェーン ----
blockchain "eth":
  network "ethereum"
  provider env.ETH_RPC
  contract "0x1234abcd..."
  abi "contract-abi.json"
# usage: eth.getBalance("0x..."), eth.getBlock(), eth.sendTx(wallet, to, "0.1")
