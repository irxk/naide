# ============================================
# NAIDE Language Specification
# Node AI Development Environment
# ============================================
# AIが最速でコード生成できるように設計された言語
#
# 設計原則:
#   1. 1つの書き方しかない (曖昧さゼロ)
#   2. キーワード駆動 (行頭で意図が確定)
#   3. 最小トークン数 (生成量削減 = 高速)
#   4. よく使うパターンが組み込み
#   5. インデントベース (波括弧不要)
# ============================================


# ---- 変数宣言 ----
# 型名 変数名 = 値 (不変 const)
str name = "hello"
int count = 42
num price = 9.99
bool active = true
list items = [1, 2, 3]
map config = {host: "localhost", port: 3000}
any data = null

# 可変変数 (let)
mut int counter = 0
mut str label = "initial"


# ---- 文字列補間 ----
# ダブルクォートで {式} が自動展開
str greeting = "Hello {name}, count is {count}"


# ---- 関数 ----
# fn 名前(型 引数) -> 戻り型:
fn add(int a, int b) -> int:
  ret a + b

# 戻り値なし
fn sayHi(str who):
  log "Hi {who}"

# デフォルト引数
fn greet(str name, str prefix = "Hello"):
  log "{prefix}, {name}!"

# 可変長引数
fn sum(...int nums) -> int:
  mut int total = 0
  each n in nums:
    total += n
  ret total


# ---- 非同期関数 ----
fn.async fetchUser(str id) -> map:
  any res = await fetch("/api/users/{id}")
  any data = await res.json()
  ret data


# ---- 条件分岐 ----
if count > 10:
  log "many"
elif count > 5:
  log "some"
else:
  log "few"

# インライン三項
str size = if count > 10 then "big" else "small"


# ---- ループ ----
# each: コレクション反復
each item in items:
  log item

# each with key (Object.entries)
each key, val in config:
  log "{key}: {val}"

# for: 範囲ループ
for i in 0..10:
  log i

# while
while active:
  log "running"
  active = false


# ---- パターンマッチ ----
str status = "ok"
match status:
  "ok": log "success"
  "error": log "failed"
  _: log "unknown"


# ---- エラーハンドリング ----
fn.async safeFetch(str url) -> map:
  try:
    any data = await fetch(url)
    ret {ok: true, data: data}
  fail e:
    log.error e.message
    ret {ok: false, error: e.message}
  ensure:
    log "request completed"

# try/ensure (finally) — fail ブロックなしでも使える
fn.async withCleanup():
  any conn = null
  try:
    conn = await openConnection()
    ret await conn.query("SELECT 1")
  ensure:
    if conn:
      conn.close()


# ---- 型チェック ----
# typeof: 型を文字列で返す
if typeof data == "string":
  log "data is a string"

# instanceof: インスタンス判定
if err instanceof TypeError:
  log "type error occurred"


# ---- パイプ演算子 ----
# データ変換チェーンが読みやすい
list result = [1, 2, 3, 4, 5]
  |> filter((x) => x > 2)
  |> map((x) => x * 10)


# ---- クラス (model) ----
model User:
  str name
  str email
  int age = 0

  fn greet() -> str:
    ret "Hi, I'm {self.name}"

  fn.async save():
    log "Saving {self.name}..."

# 継承
model Admin extends User:
  str role = "admin"

  fn permissions() -> list:
    ret ["read", "write", "delete"]


# ---- データベース永続化 ----
# db ディレクトリパス → スキーマストアがJSONファイルに自動保存
db "data/"

# SQLデータベース — スキーマストアがSQLテーブルに自動保存
# db.sql "sqlite" "app.db"          # SQLite (better-sqlite3)
# db.sql "postgres" "postgres://localhost/mydb"  # PostgreSQL


# ---- 環境変数 ----
env:
  PORT       int default(3000)
  JWT_SECRET str required
  DB_URL     str default("sqlite:data.db")


# ---- スキーマ定義 ----
# 型: str, int, num, bool, auto(UUID), timestamp, enum(...)
# 修飾: required, optional, min(n), max(n), email, url, unique, auto, default(val)
schema User:
  id       auto
  name     str required min(2) max(50)
  email    str required email unique
  age      int optional min(0) max(150)
  role     enum("admin", "user") default("user")
  joined   timestamp auto


# ---- サーバー定義 ----
server app port PORT:
  # CORS
  cors "*"

  # JWT認証
  auth JWT_SECRET:
    protect "/api/*"
    public "/api/auth/*"

  # レート制限
  limit "/api/*" 100 "1m"

  # 静的ファイル配信
  static "/public"

  # CRUD自動生成 (ページネーション・検索・ソート付き)
  crud "/api/users" User

  # クッキーパーサー
  cookie

  # セッション管理 (cookie-based, ゼロ依存)
  session JWT_SECRET

  # レスポンスキャッシュ
  cache "/api/*" "5m"

  # テンプレートエンジン
  view "./views"

  # Server-Sent Events
  sse "/events"

  # ファイルアップロード (ゼロ依存)
  upload "/api/upload" "avatar" (req, res):
    ret {file: req.file.filename, size: req.file.size}

  # 名前付きミドルウェア適用
  # mid myMiddleware
  # mid myMiddleware "/api"

  # ルートミドルウェア (ルートごとにミドルウェア適用)
  get "/admin" [authCheck] (req, res):
    ret {admin: true}

  post "/api/secure" [auth, logger] (req, res):
    ret req.body

  # ルートグループ
  group "/api/v1":
    get "/status":
      ret {version: "1.0"}

  # ルート
  get "/":
    ret.html "<h1>Welcome</h1>"

  post "/api/auth/register" (req, res):
    str hashed = hash(req.body.password)
    user = UserStore.create({...req.body, password: hashed})
    token = auth.sign({id: user.id})
    ret {token, user}

  post "/api/auth/login" (req, res):
    user = UserStore.where({email: req.body.email})[0]
    if not user:
      ret.status 401 {error: "Invalid credentials"}
    if not verify(req.body.password, user.password):
      ret.status 401 {error: "Invalid credentials"}
    token = sign({id: user.id})
    ret {token}

  # WebSocket
  ws "/chat":
    on "connect":
      send({type: "welcome"})
    on "message" (data):
      broadcast(data)
    on "close":
      log "client left"

  # エラーハンドラー
  error (err, req, res):
    log.error err.message
    ret.status 500 {error: "Internal error"}


