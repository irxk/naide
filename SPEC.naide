# ---- ページ生成 (HTML) ----
page "index.html":
  lang "ja"
  title "My App"
  style "styles.css"
  importmap "chart.js" "https://esm.sh/chart.js/auto"
  main "#app":
    h1 "Hello World"
    p "Welcome to NAIDE"
    button "#start" "Start"
    canvas "#game" "800" "600"
  module "build/game.mjs"

# 属性は子行として指定し、aria/data属性は attr で指定する。
page "signup.html":
  main "#app":
    form "#signup":
      action "/signup"
      method "post"
      label "Email":
        attr "for" "email"
      input:
        id "email"
        type "email"
        name "email"
        required

# ---- ブラウザーAPI・DOMイベント・Canvas ----
# Browser client source remains .naide and compiles to a native ESM .mjs file.
# "naide:browser" is a compiler-provided module, not an npm dependency.
use { document, window, fetch, localStorage, select, selectAll, listen, createElement, canvas2d, animate, text, value, state, bindText, bindValue, bindClass } from "naide:browser"
# Browser-compatible ESM packages may be resolved through the page import map.
# use Chart from "chart.js"
# Installed npm packages can be bundled into page modules:
#   naide build . build --bundle-browser

# `listen` binds normal DOM events and returns an unsubscribe function.
fn startGame(any event):
  log "Game started"

listen("#start", "click", startGame)

# `state` creates an observable value; bind helpers sync it to common DOM targets.
any counter = state(0)
bindText("#counter", counter)
fn increment(any current):
  ret current + 1
counter.update(increment)

# Access the Canvas 2D API and browser Web APIs through their native JavaScript
# objects while keeping authored application logic in NAIDE.
any canvas = select("#game")
any context = canvas2d(canvas)
mut num position = 0

fn draw(num delta, num elapsed):
  context.clearRect(0, 0, canvas.width, canvas.height)
  context.fillStyle = "#ed7d55"
  context.fillRect(position, 40, 48, 48)
  position += delta * 0.05

animate(draw)


