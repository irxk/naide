server app port 3000:
  graphql "/graphql"
# schema定義からGraphQLスキーマを自動生成


# ---- マルチプラットフォーム Bot ----
bot myBot token "TOKEN":
  on "message" (msg):
    msg.reply("Hello!")

bot slackBot type "slack" token "xoxb-xxx":
  on "message" (msg):
    msg.reply("Hi from Slack!")

bot tgBot type "telegram" token "123:ABC":
  on "message" (msg):
    msg.reply("Hi from Telegram!")

bot lineBot type "line" token "LINE_TOKEN":
  on "message" (event):
    log event


# ---- デスクトップアプリ ----
desktop myApp:
  title "My Desktop App"
  size 1024 768
  load "index.html"


# ---- モバイル / スクリーン ----
screen Home:
  text "Hello World"
  button "Click Me"
  input "Enter your name"
  image "logo.png"


# ---- OAuth (ソーシャルログイン) ----
oauth "google" env.CLIENT_ID env.CLIENT_SECRET:
  callback "/auth/callback"
  scope "email profile"

oauth "github" env.GH_ID env.GH_SECRET:
  callback "/auth/github/callback"
  scope "user:email"


# ---- 決済 (Stripe) ----
pay "stripe" env.STRIPE_KEY:
  webhook "/webhook"
  success "/thanks"
  cancel "/cancel"
# usage: pay.checkout([{name: "Item", price: 1000, qty: 1}])


# ---- ファイルストレージ (S3/GCS) ----
storage "s3" env.BUCKET env.AWS_KEY env.AWS_SECRET:
  region "ap-northeast-1"
# usage: storage.upload("key", data)
# usage: storage.download("key")
# usage: storage.remove("key")


# ---- PDF生成 ----
pdf "report.pdf":
  title "Monthly Report"
  h1 "Summary"
  text "This is the report content."
  line
  image "chart.png"


# ---- i18n (多言語) ----
i18n "locales/":
  default "en"
  lang "en" "en.json"
  lang "ja" "ja.json"
# usage: i18n.t("greeting.hello")
# usage: i18n.setLang("ja")


# ---- Push通知 ----
push env.VAPID_PUBLIC env.VAPID_PRIVATE:
  endpoint "/subscribe"
# usage: push.send(subscription, "Title", "Body")


# ---- 全文検索 ----
search "meilisearch" "http://localhost:7700" env.MEILI_KEY:
  index "products"
# usage: search.query("keyword")
# usage: search.add([{id: 1, name: "Item"}])


# ---- 画像処理 ----
image "photo.jpg" -> "output.jpg":
  resize 800 600
  grayscale
  watermark "logo.png"


# ---- CSV/Excelエクスポート ----
csv "users" format "csv":
  columns "name" "email" "age"
  from data
# Excel形式
csv "report" format "xlsx":
  columns "id" "value" "date"
  from items
  output "monthly_report.xlsx"

# ---- ロギング ----
logging "app":
  level "info"
  file "app.log"
  format "json"
  rotate "14d"
# usage: logger.info("message"), logger.error("fail")

# ---- DBマイグレーション ----
migrate "create_users":
  up:
    log "Creating users table"
  down:
    log "Dropping users table"

# ---- gRPC ----
grpc "users" port 50051:
  rpc getUser(id) -> user
  rpc createUser(data) -> user
  rpc deleteUser(id) -> result

# ---- WebRTC ----
webrtc "video-chat":
  stun "stun:stun.l.google.com:19302"
  on offer(data):
    log "Received offer"
  on answer(data):
    log "Received answer"
  on candidate(data):
    log "ICE candidate"

# ---- ブロックチェーン ----
blockchain "eth":
  network "ethereum"
  provider env.ETH_RPC
  contract "0x1234abcd..."
  abi "contract-abi.json"
# usage: eth.getBalance("0x..."), eth.getBlock(), eth.sendTx(wallet, to, "0.1")


# ============================================
# シンプルシンタックス (Pythonより簡単)
# ============================================

# ---- unless (ifの逆) ----
unless x > 10:
  log "xは10以下"

# ---- until (whileの逆) ----
mut int i = 0
until i > 10:
  i = i + 1

# ---- repeat (簡単ループ) ----
repeat 5:
  log "hello"

repeat 10 as i:
  log i

# ---- enum (列挙型) ----
enum Color:
  RED
  GREEN
  BLUE

# インライン形式
enum Status: ACTIVE, INACTIVE, PENDING

# ---- swap (値の交換) ----
mut int a = 1
mut int b = 2
swap a, b

# ---- is / isnt (比較演算子) ----
if x is 5:
  log "xは5"
if y isnt null:
  log "yはnullじゃない"

# ---- 一行関数 ----
fn double(int x) -> int = x * 2
fn greet(str name) -> str = "Hello, {name}!"

# ---- print (logのエイリアス) ----
print "hello world"

# ---- ビルトイン関数 ----
# 型変換
str s = str(42)
int n = int("42")
num f = float("3.14")

# 文字列操作
str u = upper("hello")        # "HELLO"
str l = lower("HELLO")        # "hello"
str t = trim("  hi  ")        # "hi"
list parts = split("a,b,c", ",")  # ["a","b","c"]
str joined = join(parts, "-")     # "a-b-c"
str replaced = replace("hello", "l", "r")  # "herro"
bool has = contains("hello", "ell")  # true

# コレクション操作
int length = len(items)
list sorted = sort(items)
list reversed = reverse(items)
list uniq = unique([1,1,2,3])  # [1,2,3]
list k = keys(obj)
list v = values(obj)
list e = entries(obj)
list r = range(10)             # [0,1,...,9]
list chunks = chunk([1,2,3,4], 2)  # [[1,2],[3,4]]
list zipped = zip([1,2], ["a","b"])
list flattened = flat([[1,2],[3,4]])

# 数学
num a2 = abs(-5)
num r2 = round(3.7)
num c = ceil(3.1)
num fl = floor(3.9)
num sq = sqrt(16)
num p = pow(2, 10)
num total = sum([1,2,3])

# JSON
any data2 = json_parse('{"a":1}')
str json = json_str(data2)

# 時間
int timestamp = now()
str timestr = time()

# I/O
str content = read("file.txt")
write("out.txt", content)
str answer = ask("名前は？")

# その他
sleep(1000)
exit(0)
