{
  "name": "naider",
  "version": "2.0.10",
  "description": "NAIDE is a readable, practical programming language with NaideVM, a multi-target compiler, type checking, and batteries-included development tools.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./runtime": "./src/runtime.js",
    "./loader": "./src/loader.js",
    "./register": "./src/register.js",
    "./host": "./src/host.js",
    "./native": "./src/native.js",
    "./native-adapters": "./src/native-adapters.js",
    "./release-status": "./src/release-status.js"
  },
  "bin": {
    "naide": "bin/naide.js",
    "naide-mcp": "mcp/server.js",
    "naide-host": "bin/naide-host.js"
  },
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "assets/",
    "mcp/",
    "lsp/",
    "benchmark/",
    "native/",
    "examples/",
    "docs/",
    "vscode-naide/",
    "SPEC.naide",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:targets": "node --test test/targets.js",
    "test:runtimes": "node --test test/target-runtimes.js",
    "test:parity": "node --test test/compiler-parity.js",
    "test:onboarding": "node --test test/onboarding.js",
    "test:features": "node --test test/project-tools.js test/mcp.js test/lsp.js test/security.js test/onboarding.js test/onboarding-integration.js test/native-meld.js",
    "benchmark:engines": "node benchmark/engines.js",
    "build:native-jit": "node-gyp rebuild --directory native",
    "example": "node bin/naide.js examples/hello.naide",
    "postinstall": "node bin/postinstall.js"
  },
  "keywords": [
    "ai",
    "language",
    "transpiler",
    "nodejs",
    "code-generation",
    "llm",
    "claude",
    "chatgpt",
    "naide",
    "dsl",
    "express",
    "api",
    "backend",
    "server",
    "discord",
    "discord-bot",
    "slack",
    "telegram",
    "line",
    "graphql",
    "cli",
    "email",
    "desktop",
    "mobile",
    "electron",
    "react-native",
    "cron",
    "python",
    "bun",
    "csv",
    "excel",
    "logging",
    "migration",
    "grpc",
    "webrtc",
    "blockchain",
    "web3",
    "typescript",
    "java",
    "go",
    "rust",
    "swift",
    "kotlin",
    "dart",
    "csharp",
    "cpp",
    "ruby",
    "php"
  ],
  "author": "pirikari.sena@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/irxk/naide"
  },
  "homepage": "https://github.com/irxk/naide#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "express": "^4.22.3",
    "node-gyp": "^12.4.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "esbuild": "^0.25.12"
  }
}
