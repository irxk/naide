{
  "name": "naider",
  "version": "1.16.0",
  "description": "NAIDE - Simpler than Python, compiles to 15 targets. AI-specialized language with 35+ built-in functions, syntax sugar (unless/until/repeat/swap/is/isnt), and 47 features. Targets: Node.js, Python, TypeScript, C, C++, Java, Go, Rust, PHP, Ruby, Kotlin, Swift, Dart, C#, Bun.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./runtime": "./src/runtime.js"
  },
  "bin": {
    "naide": "bin/naide.js"
  },
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "lsp/",
    "examples/",
    "vscode-naide/",
    "SPEC.naide",
    "SPEC-X.nx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/test.js",
    "example": "node bin/naide.js examples/hello.naide",
    "example:x": "node bin/naide.js examples/hello.nx"
  },
  "keywords": [
    "ai",
    "language",
    "transpiler",
    "nodejs",
    "code-generation",
    "llm",
    "claude",
    "chatgpt",
    "naide",
    "dsl",
    "express",
    "api",
    "backend",
    "server",
    "discord",
    "discord-bot",
    "slack",
    "telegram",
    "line",
    "graphql",
    "cli",
    "email",
    "desktop",
    "mobile",
    "electron",
    "react-native",
    "cron",
    "python",
    "bun",
    "csv",
    "excel",
    "logging",
    "migration",
    "grpc",
    "webrtc",
    "blockchain",
    "web3",
    "typescript",
    "java",
    "go",
    "rust",
    "swift",
    "kotlin",
    "dart",
    "csharp",
    "cpp",
    "ruby",
    "php"
  ],
  "author": "pirikari.sena@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/irxk/naide"
  },
  "homepage": "https://github.com/irxk/naide#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
